# Copy to .env for local development. Real values are set in Vercel, never committed.
# See HANDOFF.md section 7.

# GoHighLevel workflow "Inbound Webhook" trigger URL
GHL_INBOUND_WEBHOOK_URL=

# Google Tag Manager container ID (GTM-XXXXXXX)
PUBLIC_GTM_ID=

# GoHighLevel calendar embed URL for /book
PUBLIC_GHL_BOOKING_URL=

# Homepage hero: "classic" (default, or unset) is the original slideshow;
# "scroll" is the ScrollHero prototype. Override per-request with
# /?hero=scroll or /?hero=classic regardless of this value.
PUBLIC_HERO_VARIANT=
