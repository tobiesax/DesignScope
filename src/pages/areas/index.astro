---
import Layout from '../../layouts/Layout.astro';
import { business } from '../../data/business';
import { towns } from '../../data/areas';
import FinalCta from '../../components/shared/FinalCta.astro';

// The design handoff has no separate "service area hub" page (just the
// town template) — this keeps CLAUDE.md's own sitemap entry, restyled to
// match the handoff's visual system.
const otherTowns = business.serviceAreas.filter((t) => !towns.some((town) => town.name === t));
---

<Layout
  title="Service Areas"
  description="Design Scope serves Bloomfield, West Hartford, Simsbury, Avon, Windsor and the wider Farmington Valley, Connecticut."
>
  <section class="flex flex-col gap-4 px-4 py-11 sm:px-7">
    <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
      Where we work
    </span>
    <h1 class="text-[34px] leading-[1.02] font-black tracking-tight sm:text-[52px]">
      Hartford County and the Farmington Valley
    </h1>
  </section>

  <div class="grid gap-3.5 px-4 pb-8 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))]">
    {towns.map((town) => (
      <a
        href={`/areas/${town.slug}/`}
        class="card-hover bg-paper-muted border-brand flex flex-col gap-2 border-t-[3px] p-6"
      >
        <span class="text-lg font-extrabold">{town.name}</span>
        <span class="text-muted text-xs">{town.highlight}</span>
      </a>
    ))}
  </div>

  <section class="flex flex-col gap-3 px-4 pb-12 sm:px-7">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      Also serving
    </span>
    <div class="flex flex-wrap gap-1.5">
      {otherTowns.map((t) => (
        <span class="border-border-soft bg-paper border px-3 py-2 text-xs font-semibold">{t}</span>
      ))}
    </div>
  </section>

  <FinalCta />
</Layout>
