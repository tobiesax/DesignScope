---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blog-posts';

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Blog" description="Design and construction tips from Design Scope, Bloomfield CT.">
  <section class="flex flex-col gap-4 px-4 py-12 sm:px-7">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">Blog</span>
    <h1 class="text-3xl font-black tracking-tight sm:text-4xl">Design &amp; construction tips</h1>
  </section>

  <div class="flex flex-col gap-5 px-4 pb-12 sm:px-7">
    {blogPosts.map((post) => (
      <a
        href={`/blog/${post.slug}/`}
        class="card-hover border-border-soft flex flex-col gap-2 border-b pb-5"
      >
        <span class="text-muted text-xs font-semibold">
          {formatDate(post.date)} · {post.author}
        </span>
        <span class="text-lg font-extrabold">{post.title}</span>
        <p class="text-ink-soft text-sm leading-relaxed">{post.excerpt}</p>
        <span class="text-brand-dark text-xs font-extrabold">Read more →</span>
      </a>
    ))}
  </div>
</Layout>
