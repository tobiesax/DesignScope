---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';

// Matches the GrowthOS design handoff's 404 page exactly.
---

<Layout title="Page Not Found" description="This page couldn't be found." mobileBar={false} noindex>
  <section class="flex min-h-[440px] flex-col justify-center gap-4 px-4 py-11 sm:px-7">
    <span class="text-brand text-[96px] leading-none font-black tracking-tight">404</span>
    <h1 class="text-[34px] leading-[1.05] font-black tracking-tight sm:text-[52px]">
      This page has been remodeled
    </h1>
    <p class="text-ink-soft max-w-[520px] text-[15px] leading-relaxed">
      The page you're looking for has moved or doesn't exist. Here's where most people head next.
    </p>
    <div class="flex flex-wrap gap-2">
      <a href="/" class="border-ink border-[1.5px] px-5 py-3.5 text-sm font-bold">
        Home
      </a>
      <a href="/remodeling/" class="border-ink border-[1.5px] px-5 py-3.5 text-sm font-bold">
        Kitchen &amp; bath
      </a>
      <a href="/projects/" class="border-ink border-[1.5px] px-5 py-3.5 text-sm font-bold">
        Projects
      </a>
      <a
        href={`tel:${business.phone.mainTel}`}
        class="bg-urgent text-paper px-5 py-3.5 text-sm font-extrabold"
      >
        Emergency? Call 24/7
      </a>
    </div>
  </section>
</Layout>
