---
import Layout from '../../layouts/Layout.astro';
import { business } from '../../data/business';
import FinalCta from '../../components/shared/FinalCta.astro';

// Stephen's surname and a team photo aren't confirmed yet (CONTENT_GAPS.md) —
// the bio below uses business.ts, lifted from the live site's /stephen_author
// page minus its two unconfirmed claims (formal internship program, high-school
// trade-training initiative — see CONTENT_GAPS.md), and runs without a photo
// rather than a placeholder.
//
// The intro's side panel redesigned 2026-11-20 at Tobi's request — it had
// been a silent, muted ambient logo-animation loop (public/media/
// about-logo-animation.mp4) since no real building photo existed at the
// time, and later that same clip's poster/starting frame was swapped for
// a real office exterior photo once one turned up. But the home page's
// own About preview (AboutPreview.astro) had already moved on to
// something better: a real ~30s Design Scope promo video (Stephen
// installing cabinet crown moulding, a finished kitchen, real narration/
// audio) with a click-to-play poster + sound, not a silent ambient loop.
// This panel now uses that same real video and the same click-to-play
// pattern, dropping the logo-animation/photo-poster treatment entirely.
//
// Follow-up (same day, Tobi's request): rounded the panel's corners, and
// swapped the cover image back to the real office exterior photo
// (public/hero/01-welcome.webp, copied to public/media/
// about-office-poster.webp) instead of the video's own opening title
// card — so visitors see the actual Design Scope building before
// pressing play, not a branded title frame.
---

<Layout
  title="About Design Scope"
  description={`Family-owned design and construction company serving the Farmington Valley since ${business.foundedYear}.`}
>
  <section class="grid [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
    <div class="flex flex-col gap-4 px-4 py-12 sm:px-7">
      <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
        About us
      </span>
      <h1 class="text-3xl font-black tracking-tight sm:text-4xl">
        Family-owned since {business.foundedYear}
      </h1>
      <p class="text-ink-soft max-w-2xl text-base leading-relaxed">
        Design Scope is a locally and family-owned design and construction company proudly serving
        the Farmington Valley since 2016. Licensed and insured, we offer an all-in-one solution that
        blends thoughtful design with expert craftsmanship — creating spaces that are both current
        and timeless. From our fully equipped kitchen and bathroom showroom to our free design
        consultations, we make it easy for you to bring your vision to life. Whether your project is
        large or small, you can expect honest pricing with no hidden fees, clear communication, and
        quality work backed by a 6-month workmanship warranty.
      </p>
      <p class="text-ink-soft max-w-2xl text-base leading-relaxed">
        We're committed to making your experience simple and stress-free, offering walk-ins,
        same-day appointments (based on availability), and weekend appointments to fit your
        schedule. We provide free, no-obligation quotes within 24 hours, honor price matching on
        comparable written estimates, and can even assist with insurance paperwork and required
        permits.
      </p>
    </div>
    <div id="about-video-wrap" class="bg-ink relative min-h-[340px] overflow-hidden rounded-2xl sm:min-h-[420px]">
      <button
        type="button"
        id="about-video-play"
        aria-label="Play: an introduction to Design Scope"
        class="absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center border-0 p-0"
        style="background-image:url('/media/about-office-poster.webp');background-size:cover;background-position:center;"
      >
        <span class="bg-ink/35 absolute inset-0"></span>
        <span class="relative z-[1] flex h-14 w-20 flex-shrink-0 items-center justify-center rounded-[22px] bg-[#ff0000] text-white">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
      <video
        id="about-video"
        class="hidden h-full w-full object-cover"
        src="/media/about-intro-video.mp4"
        poster="/media/about-office-poster.webp"
        controls
        playsinline
        preload="none"
      />
    </div>
  </section>

  <section class="border-border flex flex-col gap-4 border-t px-4 py-10 sm:px-7">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      Meet {business.team.stephen.firstName} {business.team.stephen.lastName}
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">{business.team.stephen.role}</h2>
    <p class="text-ink-soft max-w-2xl text-base leading-relaxed">{business.team.stephen.bio}</p>
  </section>

  <section class="border-border grid gap-7 border-t px-4 py-10 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
    <div class="flex flex-col gap-2.5">
      <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
        What we promise
      </span>
      <ul class="text-ink-soft flex flex-col gap-1.5 text-sm leading-relaxed">
        {business.promises.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col gap-2.5">
      <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
        Memberships
      </span>
      <ul class="text-ink-soft flex flex-col gap-1.5 text-sm leading-relaxed">
        {business.memberships.map((m) => (
          <li>{m}</li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta />
</Layout>

<script>
  const playBtn = document.getElementById('about-video-play');
  const video = document.getElementById('about-video') as HTMLVideoElement | null;
  playBtn?.addEventListener('click', () => {
    playBtn.remove();
    video?.classList.remove('hidden');
    video?.play().catch(() => {});
  });
</script>
