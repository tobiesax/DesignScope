---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import WhyUs from '../../components/shared/WhyUs.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import FinalCta from '../../components/shared/FinalCta.astro';
import { kitchens } from '../../data/services';
import { faqs } from '../../data/home';

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Remodeling', href: '/remodeling/' },
  { label: 'Kitchens' },
];
---

<Layout title={kitchens.title} description={kitchens.metaDescription}>
  <ServiceHero service={kitchens} breadcrumb={breadcrumb} />

  <section class="px-4 py-10 sm:px-7">
    <p class="text-ink-soft max-w-2xl text-base leading-relaxed">{kitchens.intro}</p>
  </section>

  <ProcessSteps />
  <ServiceGallery category={kitchens.category} />
  <WhyUs />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <FinalCta />
</Layout>
