---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import IncludedInvestment from '../../components/service/IncludedInvestment.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import ThreeDDesignBlock from '../../components/service/ThreeDDesignBlock.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ReviewCarousel from '../../components/home/ReviewCarousel.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import FinalCta from '../../components/shared/FinalCta.astro';
import { kitchens, remodelProcess, remodelFaqs } from '../../data/services';
import { kitchenProjects, projectImages } from '../../data/project-images';

// Page order matches the GrowthOS design handoff's "Kitchen & bath" remodel
// page exactly (the Kitchens tab's content), at Tobi's request.
const galleryProjects = kitchenProjects.map((project) => ({
  ...project,
  img: projectImages[project.img],
}));
---

<Layout title={kitchens.title} description={kitchens.metaDescription} active="remodeling">
  <ServiceHero service={kitchens} />

  <IncludedInvestment included={kitchens.included ?? []} ranges={kitchens.ranges ?? []} />

  <ProcessSteps
    steps={remodelProcess}
    eyebrow={false}
    heading="How it works"
    background="paper-muted"
  />

  <ThreeDDesignBlock />

  <ServiceGallery
    heading="Recent work"
    subheading="Recent kitchens"
    projects={galleryProjects}
    limit={3}
  />

  <ReviewCarousel />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={remodelFaqs} title="Questions homeowners ask" />
    </div>
  </section>

  <FinalCta />
</Layout>
