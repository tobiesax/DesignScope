---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import ThreeDDesignBlock from '../../components/service/ThreeDDesignBlock.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ReviewCarousel from '../../components/home/ReviewCarousel.astro';
import WhyUs from '../../components/shared/WhyUs.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import FinalCta from '../../components/shared/FinalCta.astro';
import { homeRenovations, remodelProcess, remodelFaqs } from '../../data/services';

// The design handoff has no dedicated "home renovations" page (whole-home
// work only appears as a Projects case study and a 3-up band link), so
// this page keeps its own content but is now brought up to the same
// section order as Kitchens/Bathrooms for consistency: hero, process,
// 3D design, recent work, reviews, why-us, FAQ, final CTA. No "What's
// included / Typical investment" block — the handoff has no whole-home
// price ranges to draw from, and inventing figures would violate
// CLAUDE.md rule 2.
---

<Layout
  title={homeRenovations.title}
  description={homeRenovations.metaDescription}
  active="remodeling"
>
  <ServiceHero service={homeRenovations} />

  <section class="px-4 py-10 sm:px-7">
    <p class="text-ink-soft max-w-2xl text-base leading-relaxed">{homeRenovations.intro}</p>
  </section>

  <ProcessSteps
    steps={remodelProcess}
    eyebrow={false}
    heading="How it works"
    background="paper-muted"
  />

  <ThreeDDesignBlock />

  <ServiceGallery
    heading="Recent work"
    subheading="Recent whole-home renovations"
    category="Home renovations"
    limit={3}
  />

  <ReviewCarousel />

  <WhyUs />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={remodelFaqs} title="Questions homeowners ask" />
    </div>
  </section>

  <FinalCta />
</Layout>
