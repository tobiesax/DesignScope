---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import IncludedInvestment from '../../components/service/IncludedInvestment.astro';
import CostEstimator from '../../components/service/CostEstimator.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import StyleQuiz from '../../components/service/StyleQuiz.astro';
import AgingInPlace from '../../components/service/AgingInPlace.astro';
import ThreeDDesignBlock from '../../components/service/ThreeDDesignBlock.astro';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import ReviewCarousel from '../../components/home/ReviewCarousel.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import FinalCta from '../../components/shared/FinalCta.astro';
import { bathrooms, remodelProcess, remodelFaqs } from '../../data/services';
import { bathroomProjects, projectImages } from '../../data/project-images';

// Page order matches the GrowthOS design handoff's "Kitchen & bath" remodel
// page exactly (the Bathrooms tab's content, plus the handoff's aging-in-
// place block, which belongs here content-wise), at Tobi's request —
// including the Phase 2 cost estimator and style quiz, built in now
// rather than left out, per Tobi's explicit follow-up request.
const galleryProjects = bathroomProjects.map((project) => ({
  ...project,
  img: projectImages[project.img],
}));
---

<Layout title={bathrooms.title} description={bathrooms.metaDescription} active="remodeling">
  <ServiceHero service={bathrooms} />

  <IncludedInvestment included={bathrooms.included ?? []} ranges={bathrooms.ranges ?? []} />

  <CostEstimator room="bath" />

  <ProcessSteps
    steps={remodelProcess}
    eyebrow={false}
    heading="How it works"
    background="paper-muted"
  />

  <StyleQuiz />

  <AgingInPlace />

  <ThreeDDesignBlock />

  <ServiceGallery
    heading="Recent work"
    subheading="Recent bathrooms"
    projects={galleryProjects}
    limit={3}
  />

  <ReviewCarousel />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={remodelFaqs} title="Questions homeowners ask" />
    </div>
  </section>

  <FinalCta />
</Layout>
