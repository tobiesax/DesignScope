---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import { kitchens, bathrooms, homeRenovations, remodelProcess, remodelFaqs } from '../../data/services';
import { business } from '../../data/business';

// Path-picker hub between the nav's "Kitchen & bath" link and the three
// rebuilt service pages. Not part of the design handoff (its nav goes
// straight to one combined page), so there's no spec to match — but it's
// the actual landing page from the main nav, so it needs real titles, not
// raw URL slugs as a previous pass left it showing.
// Blurbs lifted from the live site's own /residential-services page
// (scraped 2026-11-13), one clause per category.
const joinWithAnd = (items: readonly string[]) =>
  items.length <= 1 ? (items[0] ?? '') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;

const services = [
  {
    ...kitchens,
    label: 'Kitchens',
    blurb: 'Current and timeless designs, crafted around how you cook and live.',
  },
  {
    ...bathrooms,
    label: 'Bathrooms',
    blurb: 'Every detail, from initial design concepts to final installation.',
  },
  {
    ...homeRenovations,
    label: 'Home renovations',
    blurb: 'Tailored to your specific needs and vision, whatever the size.',
  },
];
---

<Layout
  title="Remodeling in Bloomfield, CT"
  description="Kitchen, bathroom and whole-home remodeling in Bloomfield, West Hartford, Simsbury, Avon and Windsor, CT. Free design consultation, 24-hour written quote, 6-month warranty."
  active="remodeling"
>
  <section class="flex flex-col gap-4 px-4 py-12 sm:px-7">
    <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
      Remodeling
    </span>
    <h1 class="text-3xl font-black tracking-tight sm:text-4xl">
      Kitchens, bathrooms and home renovations
    </h1>
    <p class="text-ink-soft max-w-2xl text-base leading-relaxed">
      Free design consultation, a written quote within 24 hours, and one team handling design
      through construction. Pick a room to see our process and recent work.
    </p>
    <!-- Expanded 2026-11-28 at Tobi's request ("page looks lean, not
         information rich") for SEO/GEO depth — grounded only in facts
         already confirmed in business.ts: the service-area towns,
         HBRA/KBIS membership, the showroom, price matching, "our own
         crews" and the 6-month warranty. Nothing new invented. -->
    <p class="text-ink-soft max-w-2xl text-base leading-relaxed">
      Design Scope has been planning and building kitchens, bathrooms and whole-home renovations
      for Farmington Valley homeowners since {business.foundedYear}, serving{' '}
      {joinWithAnd(business.townPages)} across Hartford County. Every project starts the same way,
      a free 45-minute design consultation at our Bloomfield showroom, in your home or by video,
      where you can handle real cabinetry, countertop and tile samples from brands like{' '}
      {joinWithAnd(business.supplierBrands)} instead of choosing from a screen. You'll have a
      written, itemized quote within 24 hours, backed by price matching on competing written
      estimates, and the same team that designs your project builds it, our own crews, not a
      rotating list of subcontractors. As members of {joinWithAnd(business.memberships)}, we also
      handle the building permit paperwork, and every finished room carries a {business.warranty}{' '}
      in writing.
    </p>
  </section>

  <div class="grid gap-3.5 px-4 pb-12 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]">
    {services.map((service) => (
      <a
        href={`/remodeling/${service.slug}/`}
        class="card-hover bg-paper-muted flex flex-col overflow-hidden"
      >
        <Image src={service.heroImage} alt={service.label} class="h-[200px] w-full object-cover" />
        <div class="flex flex-col gap-1.5 p-5">
          <span class="text-lg font-extrabold">{service.label}</span>
          <span class="text-muted text-sm leading-relaxed">{service.blurb}</span>
          <span class="text-brand-dark mt-1 text-xs font-extrabold">
            See our {service.label.toLowerCase()} work →
          </span>
        </div>
      </a>
    ))}
  </div>

  <ProcessSteps steps={remodelProcess} eyebrow={false} heading="How it works" background="paper-muted" />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={remodelFaqs} title="Questions homeowners ask" />
    </div>
  </section>
</Layout>
