---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import {
  commercial,
  sectors,
  commercialWhy,
  clientLogoPlaceholders,
  commercialQuotes,
  commercialCaseStudy,
  servicePlans,
} from '../../data/commercial';
import { commercialProjects, projectImages } from '../../data/project-images';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import CommercialQuoteForm from '../../components/service/CommercialQuoteForm.astro';
import { business } from '../../data/business';

// Page order matches the GrowthOS design handoff's Commercial page
// exactly, at Tobi's request.
const galleryProjects = commercialProjects.map((project) => ({
  ...project,
  img: projectImages[project.img],
}));
---

<Layout
  title={commercial.title}
  description={commercial.metaDescription}
  navVariant="commercial"
  active="commercial"
>
  <section class="relative min-h-[340px]">
    <Image
      src={projectImages['commercial-hero']}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 1024, 1600]}
      sizes="100vw"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg,rgba(14,14,14,0.9) 0%,rgba(14,14,14,0.3) 100%)"
    ></div>
    <div class="relative flex max-w-[620px] flex-col gap-4 px-4 py-12 text-paper sm:px-10 sm:py-16">
      <span class="text-brand text-[10px] font-bold tracking-[0.3em] uppercase">
        {commercial.heroEyebrow}
      </span>
      <h1 class="text-[34px] leading-[1.02] font-black tracking-tight sm:text-[52px]">
        {commercial.heroHeadline}
      </h1>
      <p class="text-on-dark text-[15px] leading-relaxed">{commercial.heroSubcopy}</p>
      <div class="flex flex-wrap gap-2.5">
        <a href="#quote" class="bg-brand text-ink px-5 py-3.5 text-sm font-extrabold">
          Request a quote
        </a>
        <a
          href={`tel:${business.phone.mainTel}`}
          class="border-[1.5px] border-paper px-5 py-3.5 text-sm font-bold"
        >
          {business.phone.main}
        </a>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-5.5 px-4 py-13 sm:px-7">
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">Who we work with</h2>
    <div class="grid gap-[3px] [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
      {sectors.map((s) => (
        <div class="bg-paper-muted flex flex-col gap-2 p-5.5">
          <span class="text-[15.5px] font-black">{s.t}</span>
          <span class="text-muted text-[12.5px] leading-relaxed">{s.b}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-dark text-paper grid gap-6.5 px-4 py-13 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]">
    {commercialWhy.map((w) => (
      <div class="border-brand flex flex-col gap-2 border-t-2 pt-4">
        <span class="text-[15px] font-extrabold">{w.t}</span>
        <span class="text-on-dark-muted text-[12.5px] leading-relaxed">{w.b}</span>
      </div>
    ))}
  </section>

  <section class="border-border-soft flex flex-col gap-5 border-b px-4 py-11 sm:px-7">
    <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
      Trusted by property managers across Greater Hartford
    </span>
    <div class="grid gap-2 [grid-template-columns:repeat(auto-fit,minmax(130px,1fr))]">
      {Array.from({ length: clientLogoPlaceholders }).map(() => (
        <div class="bg-paper-muted text-muted flex h-16 items-center justify-center text-[10.5px] font-bold tracking-[0.15em] uppercase">
          Client logo
        </div>
      ))}
    </div>
    <div class="grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
      {commercialQuotes.map((q) => (
        <div class="bg-paper-muted flex flex-col gap-2.5 p-5.5">
          <span class="text-[14.5px] leading-relaxed font-semibold">&ldquo;{q.q}&rdquo;</span>
          <span class="text-muted text-[11.5px] font-bold">{q.who} · sample</span>
        </div>
      ))}
    </div>
  </section>

  <section class="grid items-center gap-7 px-4 py-13 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
    <a href="/projects/" class="block min-h-[280px]">
      <Image
        src={projectImages['commercial-hero']}
        alt=""
        class="h-full min-h-[280px] w-full object-cover"
      />
    </a>
    <div class="flex flex-col gap-3">
      <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
        Case study
      </span>
      <h3 class="text-[24px] leading-tight font-black">{commercialCaseStudy.title}</h3>
      <p class="text-ink-soft text-sm leading-relaxed">{commercialCaseStudy.body}</p>
      <a
        href="/projects/"
        class="border-brand text-ink self-start border-b-2 pb-0.5 text-[13px] font-extrabold"
      >
        Read the case study →
      </a>
    </div>
  </section>

  <section class="bg-dark text-paper flex flex-col gap-5.5 px-4 py-13 sm:px-7">
    <div class="flex flex-col gap-2">
      <span class="flex items-center gap-2.5 text-[10px] font-bold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
        Service agreements
      </span>
      <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">
        Keep every property in shape
      </h2>
      <p class="text-on-dark-muted max-w-[640px] text-sm leading-relaxed">
        A fixed monthly plan for planned maintenance, unit turnovers and priority emergency
        response.
      </p>
    </div>
    <div class="grid gap-2.5 [grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))]">
      {servicePlans.map((plan) => (
        <div
          class:list={[
            'flex flex-col gap-3 p-6',
            plan.popular ? 'bg-brand text-ink' : 'bg-[#222222] text-paper',
          ]}
        >
          <div class="flex items-center justify-between gap-2">
            <span class="text-[17px] font-black">{plan.name}</span>
            {plan.popular && (
              <span class="bg-dark text-paper px-1.5 py-1 text-[9.5px] font-extrabold tracking-[0.1em] uppercase">
                Most popular
              </span>
            )}
          </div>
          <span class="text-[26px] font-black tracking-tight">{plan.price}</span>
          <div class="flex flex-col gap-1.5">
            {plan.items.map((item) => (
              <span class="text-[12.5px] leading-relaxed">· {item}</span>
            ))}
          </div>
          <a
            href="#quote"
            class:list={[
              'mt-auto border-[1.5px] p-3 text-center text-[12.5px] font-extrabold',
              plan.popular ? 'border-ink' : 'border-paper',
            ]}
          >
            Ask about this plan
          </a>
        </div>
      ))}
    </div>
    <span class="text-on-dark-muted text-[11px]">
      Plan prices are draft placeholders — final pricing is Stephen's call before this section goes
      live.
    </span>
  </section>

  <ServiceGallery subheading="Real Design Scope commercial work" projects={galleryProjects} />

  <CommercialQuoteForm />
</Layout>
