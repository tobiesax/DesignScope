---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import {
  commercial,
  sectors,
  whenYouNeedThis,
  showroomForCommercial,
  commercialWhy,
  commercialCaseStudy,
  contractorPartnership,
} from '../../data/commercial';
import { commercialProjects, projectImages } from '../../data/project-images';
import ServiceGallery from '../../components/service/ServiceGallery.astro';
import CommercialQuoteForm from '../../components/service/CommercialQuoteForm.astro';
import Offers from '../../components/home/Offers.astro';
import { business } from '../../data/business';

// Page order matches the GrowthOS design handoff's Commercial page
// exactly, at Tobi's request.
const galleryProjects = commercialProjects.map((project) => ({
  ...project,
  img: projectImages[project.img],
}));
---

<Layout
  title={commercial.title}
  description={commercial.metaDescription}
  navVariant="commercial"
  active="commercial"
>
  <section class="relative min-h-[340px]">
    <!-- Swapped 2026-11-28 at Tobi's request ("find something better in
         archive") — the old hero.jpg conference-room photo has visible
         wall glare/texture and a smaller, less impressive space. This is
         the real "Employee break room and seating" gallery photo, a
         wider, better-lit shot that makes a stronger first impression;
         removed from the gallery grid below (ServiceGallery) so it's not
         shown twice on the same page. -->
    <Image
      src={projectImages['commercial1']}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(90deg,rgba(14,14,14,0.9) 0%,rgba(14,14,14,0.3) 100%)"
    ></div>
    <div class="relative flex max-w-[620px] flex-col gap-4 px-4 py-12 text-paper sm:px-10 sm:py-16">
      <span class="text-brand text-[10px] font-bold tracking-[0.3em] uppercase">
        {commercial.heroEyebrow}
      </span>
      <h1 class="text-[34px] leading-[1.02] font-black tracking-tight sm:text-[52px]">
        {commercial.heroHeadline}
      </h1>
      <p class="text-on-dark text-[15px] leading-relaxed">{commercial.heroSubcopy}</p>
      <div class="flex flex-wrap gap-2.5">
        <a href="#quote" class="bg-brand text-ink px-5 py-3.5 text-sm font-extrabold">
          Request a quote
        </a>
        <a
          href={`tel:${business.phone.mainTel}`}
          class="border-[1.5px] border-paper px-5 py-3.5 text-sm font-bold"
        >
          {business.phone.main}
        </a>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-3.5 px-4 py-12 sm:px-7">
    <h2 class="text-[24px] font-black tracking-tight sm:text-[28px]">{commercial.introHeading}</h2>
    {commercial.introBody.map((p) => (
      <p class="text-ink-soft max-w-2xl text-[15px] leading-relaxed">{p}</p>
    ))}
  </section>

  <section class="border-border-soft grid gap-7 border-t px-4 py-12 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
    <div class="flex flex-col gap-3">
      <h3 class="text-xl font-black tracking-tight">{commercial.renovations.heading}</h3>
      <p class="text-ink-soft text-sm leading-relaxed">{commercial.renovations.body}</p>
      <div class="flex flex-col">
        {commercial.renovations.services.map((item) => (
          <div class="border-line flex items-start gap-3 border-t py-2.5 text-sm leading-relaxed">
            <span class="bg-brand mt-1.5 h-2 w-2 flex-shrink-0 rotate-45"></span>
            <span class="font-semibold">{item}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-3">
      <h3 class="text-xl font-black tracking-tight">{commercial.restorations.heading}</h3>
      <p class="text-ink-soft text-sm leading-relaxed">{commercial.restorations.body}</p>
      <div class="flex flex-col">
        {commercial.restorations.services.map((item) => (
          <div class="border-line flex items-start gap-3 border-t py-2.5 text-sm leading-relaxed">
            <span class="bg-urgent mt-1.5 h-2 w-2 flex-shrink-0 rotate-45"></span>
            <span class="font-semibold">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-border-soft flex flex-col gap-5.5 border-t px-4 py-13 sm:px-7">
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">Who we work with</h2>
    <div class="grid gap-[3px] [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
      {sectors.map((s) => (
        <div class="bg-paper-muted flex flex-col gap-2 p-5.5">
          <span class="text-[15.5px] font-black">{s.t}</span>
          <span class="text-muted text-[12.5px] leading-relaxed">{s.b}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-paper-muted flex flex-col gap-5 px-4 py-13 sm:px-7">
    <div class="flex flex-col gap-2.5">
      <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">{whenYouNeedThis.heading}</h2>
      <p class="text-ink-soft max-w-2xl text-sm leading-relaxed">{whenYouNeedThis.intro}</p>
    </div>
    <div class="grid gap-2 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]">
      {whenYouNeedThis.triggers.map((t) => (
        <div class="flex items-start gap-2.5 bg-white px-4 py-3 text-sm leading-relaxed">
          <span class="bg-brand mt-1.5 h-2 w-2 flex-shrink-0 rotate-45"></span>
          <span class="font-semibold">{t}</span>
        </div>
      ))}
    </div>
    <p class="text-ink-soft max-w-2xl text-sm leading-relaxed">{whenYouNeedThis.closing}</p>
  </section>

  <section
    data-dark-section
    class="bg-dark text-paper flex flex-col gap-6.5 px-4 py-13 sm:px-7"
  >
    <div class="grid gap-6.5 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]">
      {commercialWhy.map((w) => (
        <div class="border-brand flex flex-col gap-2 border-t-2 pt-4">
          <span class="text-[15px] font-extrabold">{w.t}</span>
          <span class="text-on-dark-muted text-[12.5px] leading-relaxed">{w.b}</span>
        </div>
      ))}
    </div>
    <p class="text-on-dark-muted max-w-2xl text-sm leading-relaxed">{showroomForCommercial}</p>
  </section>

  <section class="grid items-center gap-7 px-4 py-13 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
    <a href="/projects/" class="block min-h-[280px]">
      <Image
        src={projectImages['commercial-hero']}
        alt="Commercial renovation project"
        class="h-full min-h-[280px] w-full object-cover"
      />
    </a>
    <div class="flex flex-col gap-3">
      <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
        Case study
      </span>
      <h3 class="text-[24px] leading-tight font-black">{commercialCaseStudy.title}</h3>
      <p class="text-ink-soft text-sm leading-relaxed">{commercialCaseStudy.body}</p>
      <a
        href="/projects/"
        class="border-brand text-ink self-start border-b-2 pb-0.5 text-[13px] font-extrabold"
      >
        Read the case study →
      </a>
    </div>
  </section>

  <section data-dark-section class="bg-dark text-paper flex flex-col gap-5.5 px-4 py-13 sm:px-7">
    <div class="flex flex-col gap-2">
      <span class="flex items-center gap-2.5 text-[10px] font-bold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
        {contractorPartnership.eyebrow}
      </span>
      <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">
        {contractorPartnership.heading}
      </h2>
      <p class="text-on-dark-muted max-w-[640px] text-sm leading-relaxed">
        {contractorPartnership.body}
      </p>
    </div>
    <div class="flex flex-col">
      {contractorPartnership.bullets.map((item) => (
        <div class="border-paper/15 flex items-start gap-3 border-t py-2.5 text-sm leading-relaxed">
          <span class="bg-brand mt-1.5 h-2 w-2 flex-shrink-0 rotate-45"></span>
          <span class="font-semibold">{item}</span>
        </div>
      ))}
    </div>
    <p class="text-on-dark-muted max-w-[640px] text-sm leading-relaxed">
      {contractorPartnership.closing}
    </p>
    <div class="flex flex-wrap gap-2.5">
      <a
        href={`mailto:${business.email}?subject=${encodeURIComponent('Contractor partnership inquiry')}`}
        class="bg-brand text-ink px-5 py-3.5 text-sm font-extrabold"
      >
        Email us about partnering
      </a>
      <a
        href={`tel:${business.phone.mainTel}`}
        class="border-[1.5px] border-paper px-5 py-3.5 text-sm font-bold"
      >
        {business.phone.main}
      </a>
    </div>
  </section>

  <ServiceGallery subheading="Real Design Scope commercial work" projects={galleryProjects} />

  <Offers />

  <CommercialQuoteForm />
</Layout>
