---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBadges from '../components/home/TrustBadges.astro';
import EmergencyPanel from '../components/home/EmergencyPanel.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import ReviewCarousel from '../components/home/ReviewCarousel.astro';
import ShowroomBlock from '../components/home/ShowroomBlock.astro';
import Offers from '../components/home/Offers.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import ThreeUpBand from '../components/home/ThreeUpBand.astro';

// Page order matches the GrowthOS design handoff's home page spec exactly
// (README.md "Screens → Home"), at Tobi's request. ReviewCarousel's
// reviews are the handoff's own sample content — see src/data/reviews.ts.
---

<Layout
  title="Kitchen & Bath Remodeling, Bloomfield CT"
  description="Family-owned kitchen, bath and home remodeling and restoration contractor in Bloomfield, Connecticut. Free design consultations, 24-hour quotes."
>
  <Hero />
  <TrustBadges />
  <EmergencyPanel />
  <HowItWorks />
  <FeaturedProjects />
  <ReviewCarousel />
  <ShowroomBlock />
  <Offers />
  <ServiceArea />
  <ThreeUpBand />
</Layout>
