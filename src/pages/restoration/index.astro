---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import RestorationStats from '../../components/service/RestorationStats.astro';
import WhileYouWait from '../../components/service/WhileYouWait.astro';
import ServiceDetailTabs from '../../components/service/ServiceDetailTabs.astro';
import TimelineSteps from '../../components/service/TimelineSteps.astro';
import InsuranceExplainer from '../../components/service/InsuranceExplainer.astro';
import DryOutToRebuild from '../../components/service/DryOutToRebuild.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import CallbackForm from '../../components/service/CallbackForm.astro';
import RestorationMobileBar from '../../components/service/RestorationMobileBar.astro';
import { emergencyTimeline, restorationFaqs } from '../../data/restoration';
import { mockupImages } from '../../data/mockup-images';

// Page order matches the GrowthOS design handoff's Restoration page
// exactly, at Tobi's request.
const hubHero = {
  heroImage: mockupImages.restoration,
  // No separate eyebrow text — the handoff's own hero only has the live
  // chip pill above the H1, not an additional label line.
  heroEyebrow: '',
  heroHeadline: "Water or fire damage? We're on our way.",
  heroSubcopy:
    'A real person answers day or night. We stop the damage, document everything for your insurer, and our own team rebuilds it.',
};
---

<Layout
  title={hubHero.heroHeadline}
  description={hubHero.heroSubcopy}
  navVariant="restoration"
  active="restoration"
>
  <ServiceHero service={hubHero} urgent />

  <RestorationStats />

  <WhileYouWait />

  <ServiceDetailTabs />

  <TimelineSteps
    heading="From emergency to better than before"
    subcopy="Most restoration companies leave once it's dry. Our remodeling team rebuilds it, so you deal with one company and one claim."
    steps={emergencyTimeline}
  />

  <InsuranceExplainer />

  <DryOutToRebuild />

  <section class="px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={restorationFaqs} title="Restoration questions" />
    </div>
  </section>

  <CallbackForm />

  <RestorationMobileBar />
</Layout>
