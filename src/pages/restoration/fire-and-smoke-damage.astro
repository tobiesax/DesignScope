---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import EmergencySteps from '../../components/service/EmergencySteps.astro';
import ProcessSteps from '../../components/shared/ProcessSteps.astro';
import ServiceDetailPanel from '../../components/service/ServiceDetailPanel.astro';
import FaqAccordion from '../../components/shared/FaqAccordion.astro';
import CallbackForm from '../../components/service/CallbackForm.astro';
import RestorationMobileBar from '../../components/service/RestorationMobileBar.astro';
import { fireSmoke, hubServices, restorationFaqs } from '../../data/restoration';

const fireService = hubServices.find((s) => s.key === 'fire')!;
---

<Layout
  title={fireSmoke.title}
  description={fireSmoke.metaDescription}
  navVariant="restoration"
  active="restoration"
>
  <ServiceHero service={fireSmoke} urgent />
  <EmergencySteps steps={fireSmoke.rightNowSteps} />

  <section class="flex flex-col gap-5 px-4 py-12 sm:px-7">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      What's really damaged
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">It's more than what burned</h2>
    <ul class="grid list-none gap-2.5 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
      {fireSmoke.risks.map((risk) => (
        <li class="border-border-soft bg-paper-muted border px-4 py-3.5 text-sm leading-relaxed">
          {risk}
        </li>
      ))}
    </ul>
  </section>

  <ProcessSteps
    steps={fireSmoke.process}
    eyebrow="Our process"
    heading="From assessment to final walkthrough"
  />

  <section class="px-4 py-12 sm:px-7">
    <ServiceDetailPanel service={fireService} />
  </section>

  <section class="bg-paper-muted px-4 py-12 sm:px-7">
    <div class="mx-auto max-w-2xl">
      <FaqAccordion faqs={restorationFaqs} title="Fire & smoke questions" />
    </div>
  </section>

  <CallbackForm />

  <RestorationMobileBar />
</Layout>
