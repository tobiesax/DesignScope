---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/shared/BookingModal.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description?: string;
  navVariant?: 'default' | 'restoration' | 'commercial';
  active?: 'remodeling' | 'restoration' | 'commercial' | 'showroom' | 'projects';
  // The handoff's mobile sticky action bar appears on every page except
  // Restoration (which gets its own two-button call/callback bar inline).
  mobileBar?: { label: string; href: string } | false;
}

const {
  title,
  description,
  navVariant = 'default',
  active,
  mobileBar = navVariant === 'restoration'
    ? false
    : navVariant === 'commercial'
      ? { label: 'Request a quote', href: '/commercial/#quote' }
      : { label: 'Book free consultation', href: '/book/' },
} = Astro.props;
const siteTitle = `${title} | ${business.legalName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Scroll-reveal for each page's top-level sections (global.css
      // `html.js-reveal`). Only marks the page for the CSS-driven animation
      // when IntersectionObserver exists and motion isn't reduced, so
      // content stays visible by default otherwise.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-reveal');
        document.addEventListener('DOMContentLoaded', function () {
          var targets = document.querySelectorAll('main > section, main > article');
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
          );
          targets.forEach(function (el) {
            io.observe(el);
          });
        });
      })();
    </script>
  </head>
  <body>
    <Header navVariant={navVariant} active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    {mobileBar && (
      <div class="sticky bottom-0 z-30 grid grid-cols-[2fr_1fr] md:hidden">
        <a
          href={mobileBar.href}
          data-open-booking={mobileBar.href === '/book/' ? true : undefined}
          class="bg-brand text-ink px-4 py-4 text-center text-sm font-black"
        >
          {mobileBar.label}
        </a>
        <a
          href={`tel:${business.phone.mainTel}`}
          class="bg-dark text-paper px-4 py-4 text-center text-sm font-extrabold"
        >
          Call
        </a>
      </div>
    )}
    <BookingModal />
  </body>
</html>
