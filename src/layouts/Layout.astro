---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/shared/BookingModal.astro';
import ChatWidget from '../components/shared/ChatWidget.astro';
import CookieBanner from '../components/shared/CookieBanner.astro';
import BackToTop from '../components/shared/BackToTop.astro';
import { business } from '../data/business';

interface Props {
  title: string;
  description?: string;
  navVariant?: 'default' | 'restoration' | 'commercial';
  active?: 'remodeling' | 'restoration' | 'commercial' | 'showroom' | 'projects' | 'blog';
  // The handoff's mobile sticky action bar appears on every page except
  // Restoration (which gets its own two-button call/callback bar inline).
  mobileBar?: { label: string; href: string } | false;
  /** 404 only, per the handoff's own SEO note: "noindex · HTTP 404 status". */
  noindex?: boolean;
}

const {
  title,
  description,
  navVariant = 'default',
  active,
  mobileBar = navVariant === 'restoration'
    ? false
    : navVariant === 'commercial'
      ? { label: 'Request a quote', href: '/commercial/#quote' }
      : { label: 'Book free consultation', href: '/book/' },
  noindex = false,
} = Astro.props;
const siteTitle = `${title} | ${business.legalName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;

// LocalBusiness JSON-LD (CLAUDE.md "Local SEO"). Only confirmed facts go
// in — weekend hours are "by appointment" per business.ts, not a
// structured range, so openingHoursSpecification covers Mon–Fri only
// rather than guessing a weekend range (CLAUDE.md rule 1).
const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.legalName,
  url: Astro.site?.toString(),
  telephone: business.phone.mainTel,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.showroom.streetAddress,
    addressLocality: business.showroom.city,
    addressRegion: business.showroom.state,
    postalCode: business.showroom.postalCode,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  sameAs: Object.values(business.social),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.legalName} />
    <meta property="og:title" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
    {gtmId && <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>}
    <script is:inline>
      // Scroll-reveal for each page's top-level sections (global.css
      // `html.js-reveal`). Only marks the page for the CSS-driven animation
      // when IntersectionObserver exists and motion isn't reduced, so
      // content stays visible by default otherwise.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-reveal');
        document.addEventListener('DOMContentLoaded', function () {
          var targets = document.querySelectorAll('main > section, main > article');
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
          );
          targets.forEach(function (el) {
            io.observe(el);
          });
        });
      })();
    </script>
  </head>
  <body>
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="gtm"
        />
      </noscript>
    )}
    <Header navVariant={navVariant} active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    {mobileBar && (
      <div id="mobile-sticky-bar" class="sticky bottom-0 z-30 grid grid-cols-[2fr_1fr] md:hidden">
        <a
          href={mobileBar.href}
          data-open-booking={mobileBar.href === '/book/' ? true : undefined}
          class="bg-brand text-ink flex items-center justify-center gap-1.5 px-4 py-4 text-sm font-black"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="flex-shrink-0"
          >
            <rect x="3" y="5" width="18" height="16"></rect>
            <path d="M3 10h18M8 3v4M16 3v4" />
          </svg>
          {mobileBar.label}
        </a>
        <a
          href={`tel:${business.phone.mainTel}`}
          class="bg-dark text-paper flex items-center justify-center gap-1.5 px-4 py-4 text-sm font-extrabold"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="flex-shrink-0"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Call
        </a>
      </div>
    )}
    <BookingModal />
    <ChatWidget />
    <CookieBanner />
    <BackToTop />
    <script>
      import { captureFirstTouch, pushDataLayer } from '../lib/lead';

      captureFirstTouch();

      // Delegated so it covers tel:/sms:/directions links added by any
      // component without each one wiring up its own listener
      // (HANDOFF.md section 8: click_to_call, click_to_text, get_directions).
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const link = target?.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') ?? '';
        if (href.startsWith('tel:')) {
          pushDataLayer('click_to_call', { page: window.location.pathname });
        } else if (href.startsWith('sms:')) {
          pushDataLayer('click_to_text', { page: window.location.pathname });
        } else if (
          href.includes('google.com/maps') ||
          href.includes('goo.gl/maps') ||
          link.hasAttribute('data-directions')
        ) {
          pushDataLayer('get_directions', { page: window.location.pathname });
        }
      });
    </script>
  </body>
</html>
