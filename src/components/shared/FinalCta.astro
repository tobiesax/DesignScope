---
// Matches the design handoff's showBand exactly — shown on
// Remodel/Showroom/Projects/Town pages. It's a bare band: heading,
// subcopy, one CTA. No decorative form (an earlier pass added one that
// wasn't in the handoff).
---

<section class="bg-brand flex flex-wrap items-center justify-between gap-5 px-4 py-11 sm:px-7">
  <div class="text-ink flex flex-col gap-1.5">
    <h2 class="text-[26px] leading-[1.1] font-black tracking-tight">
      Ready to start? Your quote in 24 hours.
    </h2>
    <p class="text-[13.5px] font-medium">
      Free design consultation at the showroom, at home or by video.
    </p>
  </div>
  <a
    href="/book/"
    data-open-booking
    class="bg-dark text-paper px-5.5 py-4 text-[13.5px] font-extrabold"
  >
    Book free consultation
  </a>
</section>
