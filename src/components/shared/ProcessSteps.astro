---
import { process as defaultProcess } from '../../data/home';

interface Props {
  steps?: { t: string; b: string }[];
  eyebrow?: string;
  heading?: string;
}

const {
  steps = defaultProcess,
  eyebrow = 'How it works',
  heading = 'Four steps, no surprises',
} = Astro.props;
---

<section class="flex flex-col gap-6.5 px-4 py-12 sm:px-7">
  <div class="flex flex-col gap-2.5">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      {eyebrow}
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">{heading}</h2>
  </div>
  <div class="grid gap-[3px] [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
    {steps.map((step, i) => {
      const isLast = i === steps.length - 1;
      return (
        <div
          class:list={[
            'flex flex-col gap-2.5 px-5 py-5.5',
            isLast ? 'bg-brand text-ink' : 'bg-dark text-paper',
          ]}
        >
          <span
            class:list={[
              'text-[30px] font-black tracking-tight',
              isLast ? 'text-ink' : 'text-brand',
            ]}
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="text-[15px] font-extrabold">{step.t}</span>
          <span class="text-[12.5px] leading-relaxed opacity-85">{step.b}</span>
        </div>
      );
    })}
  </div>
</section>
