---
// One shared consent checkbox for every form that collects a phone number
// (compliance/CRM-readiness spec, 2026-11-20, Task 2: "every form ... gets
// the same unticked consent checkbox and wording"). Unticked by default —
// never set `checked`. The exact legal text (business.ts `smsConsentText`)
// is what gets recorded as proof of consent on submit (src/lib/lead.ts);
// this component just displays that same wording with its two links as
// real anchors, instead of plain text.
import { business } from '../../data/business';

interface Props {
  id?: string;
}
const { id = 'sms-consent' } = Astro.props;
---

<label class="flex items-start gap-2 text-[12px] leading-relaxed">
  <input id={id} type="checkbox" class="mt-0.5" />
  <span class="text-ink-soft">
    I agree to receive text messages from {business.legalName} about my enquiry, appointments,
    project updates and occasional offers. Message frequency varies. Message and data rates may
    apply. Reply STOP to opt out or HELP for help. Consent is not a condition of purchase. See
    our{' '}
    <a href="/privacy/" class="underline">
      Privacy Policy
    </a>{' '}
    and{' '}
    <a href="/terms/" class="underline">
      Terms
    </a>
    .
  </span>
</label>
