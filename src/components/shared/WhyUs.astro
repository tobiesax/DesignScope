---
import { whyUs } from '../../data/home';
---

<section class="flex flex-col gap-7 px-4 py-12 sm:px-7">
  <div class="flex max-w-xl flex-col gap-2.5">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      Why Design Scope
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">
      Design to construction, all under one roof
    </h2>
  </div>
  <div class="grid [grid-template-columns:repeat(auto-fit,minmax(230px,1fr))]">
    {whyUs.map((item, i) => (
      <div class="border-border flex items-start gap-3.5 border-t py-5 pr-5">
        <span class="bg-dark text-brand flex h-[34px] w-[34px] shrink-0 items-center justify-center text-[11px] font-black">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="flex flex-col gap-1">
          <span class="text-sm font-extrabold">{item.t}</span>
          <span class="text-muted text-xs leading-relaxed">{item.b}</span>
        </div>
      </div>
    ))}
  </div>
</section>
