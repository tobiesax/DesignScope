---
import { Image } from 'astro:assets';
import { business } from '../../data/business';

interface HeroContent {
  heroImage: ImageMetadata;
  heroEyebrow: string;
  heroHeadline: string;
  heroSubcopy: string;
}

interface Props {
  service: HeroContent;
  breadcrumb: { label: string; href?: string }[];
  /** Restoration pages: leads with a tel/sms CTA and the urgent accent instead of booking. */
  urgent?: boolean;
}

const { service, breadcrumb, urgent = false } = Astro.props;
---

<section class="relative min-h-[340px]">
  <Image
    src={service.heroImage}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    widths={[640, 1024, 1600]}
    sizes="100vw"
  />
  <div
    class="absolute inset-0"
    style="background:linear-gradient(90deg,rgba(15,15,15,0.88) 0%,rgba(15,15,15,0.6) 45%,rgba(15,15,15,0.1) 100%)"
  ></div>

  <div class="relative flex flex-col gap-4 px-4 py-12 sm:px-7 sm:py-16 max-w-xl text-paper">
    <nav
      aria-label="Breadcrumb"
      class="text-on-dark-muted flex flex-wrap items-center gap-1.5 text-xs"
    >
      {breadcrumb.map((crumb, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-brand">
              {crumb.label}
            </a>
          ) : (
            <span class="text-paper">{crumb.label}</span>
          )}
        </>
      ))}
    </nav>
    <span
      class:list={[
        'text-[10px] font-semibold tracking-[0.35em] uppercase',
        urgent ? 'text-urgent' : 'text-brand',
      ]}
    >
      {service.heroEyebrow}
    </span>
    <h1 class="text-3xl font-black leading-[1.05] tracking-tight sm:text-4xl">
      {service.heroHeadline}
    </h1>
    <p class="text-on-dark text-base leading-relaxed">{service.heroSubcopy}</p>
    <div class="flex flex-wrap gap-2.5">
      {urgent ? (
        <>
          <a
            href={`tel:${business.phone.mainTel}`}
            class="bg-urgent text-paper px-5 py-3.5 text-sm font-extrabold"
          >
            Call now: {business.phone.main}
          </a>
          <a
            href={`sms:${business.phone.mainTel}`}
            class="border-paper border px-5 py-3.5 text-sm font-bold"
          >
            Text us
          </a>
        </>
      ) : (
        <>
          <a href="/book/" class="bg-brand text-ink px-5 py-3.5 text-sm font-extrabold">
            Book a free consultation
          </a>
          <a href="/projects/" class="border-paper border px-5 py-3.5 text-sm font-bold">
            See our projects
          </a>
        </>
      )}
    </div>
  </div>
</section>
