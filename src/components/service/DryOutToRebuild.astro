---
// "Dry-out to rebuild" — the handoff shows this as a drag-to-compare
// slider, but its own before and after images are the same photo (its
// "after" slot is explicitly labelled "photo needed"). Dragging a slider
// across one photo would imply a real transformation that doesn't exist
// (CLAUDE.md rule 1), so this shows an honest side-by-side instead: a real
// stand-in photo for "before", and a plainly-labelled placeholder for
// "after" until a real rebuilt-space photo exists (CONTENT_GAPS.md).
import { Image } from 'astro:assets';
import { mockupImages } from '../../data/mockup-images';
---

<section class="flex flex-col gap-4 px-4 py-13 sm:px-7">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">Dry-out to rebuild</h2>
    <span class="text-muted text-xs">A real restoration, before and after</span>
  </div>
  <div class="grid gap-2 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
    <div class="relative h-[260px] sm:h-[320px]">
      <Image src={mockupImages.restoration} alt="" class="h-full w-full object-cover" />
      <span class="bg-ink text-paper absolute top-3 left-3 px-2 py-1 text-[10px] font-extrabold">
        BEFORE
      </span>
    </div>
    <div class="bg-ink-soft relative flex h-[260px] items-center justify-center sm:h-[320px]">
      <span class="text-muted-dark max-w-[200px] text-center text-[11px] font-bold tracking-[0.15em] uppercase">
        After photo needed · rebuilt space
      </span>
      <span class="bg-brand text-ink absolute top-3 right-3 px-2 py-1 text-[10px] font-extrabold">
        AFTER
      </span>
    </div>
  </div>
</section>
