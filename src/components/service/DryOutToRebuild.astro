---
// "Dry-out to rebuild" — the handoff shows this as a drag-to-compare
// slider, but its own before and after images are the same photo. Dragging
// a slider across one photo would imply a real transformation that doesn't
// exist (CLAUDE.md rule 1), so this shows an honest side-by-side instead:
// a stand-in "before" (drying equipment) and now a stand-in "after"
// (rebuilt-space photo Tobi supplied, replacing the "photo needed"
// placeholder) — still not the same real room, so not a true before/after,
// just a representative pair (CONTENT_GAPS.md).
import { Image } from 'astro:assets';
import { mockupImages } from '../../data/mockup-images';
---

<section class="flex flex-col gap-4 px-4 py-13 sm:px-7">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">Dry-out to rebuild</h2>
    <span class="text-muted text-xs">A real restoration, before and after</span>
  </div>
  <div class="grid gap-2 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
    <div class="relative h-[260px] sm:h-[320px]">
      <Image
        src={mockupImages.restoration}
        alt="Water damage drying equipment set up in an affected room"
        class="h-full w-full object-cover"
      />
      <span class="bg-ink text-paper absolute top-3 left-3 px-2 py-1 text-[10px] font-extrabold">
        BEFORE
      </span>
    </div>
    <div class="relative h-[260px] sm:h-[320px]">
      <Image
        src={mockupImages['dry-out-after']}
        alt="Rebuilt and finished living space after restoration"
        class="h-full w-full object-cover"
      />
      <span class="bg-brand-dark text-paper absolute top-3 right-3 px-2 py-1 text-[10px] font-extrabold">
        AFTER
      </span>
    </div>
  </div>
</section>
