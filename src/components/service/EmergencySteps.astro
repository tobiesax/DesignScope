---
interface Props {
  heading?: string;
  steps: { t: string; b: string }[];
}

const { heading = 'If this is happening right now', steps } = Astro.props;
---

<section class="bg-urgent text-paper flex flex-col gap-6 px-4 py-12 sm:px-7">
  <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">{heading}</h2>
  <div class="grid gap-[3px] [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
    {steps.map((step, i) => (
      <div class="bg-dark flex flex-col gap-2.5 px-5 py-5.5">
        <span class="text-paper/60 text-[30px] font-black tracking-tight">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="text-[15px] font-extrabold">{step.t}</span>
        <span class="text-[12.5px] leading-relaxed opacity-85">{step.b}</span>
      </div>
    ))}
  </div>
</section>
