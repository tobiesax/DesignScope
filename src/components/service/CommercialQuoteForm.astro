---
// Commercial quote form — matches the handoff's "Global components →
// Commercial quote form" exactly. No CRM webhook is wired up yet
// (BUILD_PLAN.md Week 4), so "Send request" simulates success like the
// handoff's own prototype, same pattern as the booking modal and
// restoration callback form.
const types = ['Office', 'Retail', 'Multi-family', 'Healthcare', 'Restaurant'];
---

<section
  id="quote"
  class="bg-paper-muted grid items-start gap-8 px-4 py-13 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]"
>
  <div class="flex flex-col gap-3">
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">Request a commercial quote</h2>
    <p class="text-ink-soft text-sm leading-relaxed">
      Tell us the basics. A project manager replies within one business day to arrange a site walk.
    </p>
  </div>

  <div id="cq-form" class="flex flex-col gap-2.5 bg-white p-5.5">
    <span class="text-muted text-[11px] font-bold tracking-[0.15em] uppercase">Project type</span>
    <div class="flex flex-wrap gap-1.5">
      {types.map((t, i) => (
        <button
          type="button"
          data-cq-type={t}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class:list={[
            'border-[1.5px] px-3 py-2.5 text-xs font-bold',
            i === 0 ? 'bg-dark border-dark text-paper' : 'border-line bg-white text-ink',
          ]}
        >
          {t}
        </button>
      ))}
    </div>
    <div class="grid gap-2.5 sm:grid-cols-2">
      <input
        placeholder="Approx. size (sq ft)"
        aria-label="Approx. size (sq ft)"
        class="border-line border px-3 py-3 text-[13px]"
      />
      <select aria-label="Start timeline" class="border-line border bg-white px-3 py-3 text-[13px]">
        <option>Start: within 1 month</option>
        <option>1–3 months</option>
        <option>3+ months</option>
      </select>
    </div>
    <div class="grid gap-2.5 sm:grid-cols-2">
      <input
        id="cq-name"
        placeholder="Name and company"
        aria-label="Name and company"
        class="border-line border px-3 py-3 text-[13px]"
      />
      <input
        id="cq-contact"
        placeholder="Email or phone"
        aria-label="Email or phone"
        class="border-line border px-3 py-3 text-[13px]"
      />
    </div>
    <textarea
      placeholder="Address and a short description"
      aria-label="Address and a short description"
      class="border-line min-h-[70px] resize-y border px-3 py-3 text-[13px]"
    ></textarea>
    <button
      type="button"
      id="cq-submit"
      class="bg-dark text-paper px-4 py-3.5 text-center text-[13px] font-extrabold"
    >
      Send request
    </button>
    <div
      id="cq-fail"
      class="bg-red-tint hidden px-3.5 py-3 text-[12.5px] leading-relaxed font-semibold"
    >
      Something went wrong sending your request. Please try again or call.
    </div>
  </div>

  <div id="cq-done" class="border-bbb-green flex flex-col gap-2.5 border-t-4 bg-white p-6.5" hidden>
    <span class="text-[18px] font-black">Request received</span>
    <p class="text-ink-soft text-[13.5px] leading-relaxed">
      Your project manager will reply within one business day to book a site walk.
    </p>
    <button
      type="button"
      id="cq-reset"
      class="border-ink self-start border-b-[1.5px] text-xs font-bold"
    >
      Send another
    </button>
  </div>
</section>

<script>
  const formBox = document.getElementById('cq-form');
  const doneBox = document.getElementById('cq-done');
  const submitBtn = document.getElementById('cq-submit');
  const resetBtn = document.getElementById('cq-reset');
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('[data-cq-type]');

  if (formBox && doneBox && submitBtn) {
    typeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        typeButtons.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('bg-dark', active);
          b.classList.toggle('border-dark', active);
          b.classList.toggle('text-paper', active);
          b.classList.toggle('border-line', !active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-ink', !active);
        });
      });
    });

    submitBtn.addEventListener('click', () => {
      submitBtn.textContent = 'Sending…';
      // No CRM webhook is wired up yet — simulates submission like the
      // handoff's own prototype (BUILD_PLAN.md Week 4).
      setTimeout(() => {
        submitBtn.textContent = 'Send request';
        formBox.hidden = true;
        doneBox.hidden = false;
      }, 900);
    });

    resetBtn?.addEventListener('click', () => {
      doneBox.hidden = true;
      formBox.hidden = false;
    });
  }
</script>
