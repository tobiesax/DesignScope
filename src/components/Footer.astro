---
// Matches the GrowthOS design handoff's "Global components → Footer"
// exactly: 5 columns, a bottom bar, then a credentials strip.
import Logo from './Logo.astro';
import { business } from '../data/business';

const year = new Date().getFullYear();

const socialLinks = [
  { label: 'Facebook', href: business.social.facebook },
  { label: 'Instagram', href: business.social.instagram },
  { label: 'YouTube', href: business.social.youtube },
  { label: 'Yelp', href: business.social.yelp },
];

const townLinks = business.townPages.map((name) => ({
  name,
  href: `/areas/${name.toLowerCase().replace(/\s+/g, '-')}/`,
}));
---

<footer class="bg-dark-deep text-paper flex flex-col gap-6.5 px-4 py-10 pb-5 sm:px-7">
  <div class="grid grid-cols-1 gap-6 sm:[grid-template-columns:repeat(auto-fit,minmax(160px,1fr))]">
    <div class="flex flex-col gap-2.5">
      <Logo heightPx={34} />
      <span class="text-on-dark-muted text-xs leading-relaxed">
        Family-owned design and construction since {business.foundedYear}.
      </span>
    </div>

    <div class="flex flex-col gap-2 text-[12.5px]">
      <span class="text-brand mb-1 text-[9.5px] font-bold tracking-[0.25em] uppercase">
        Remodeling
      </span>
      <a href="/remodeling/" class="hover:text-brand">
        Kitchen &amp; bath
      </a>
      <a href="/commercial/" class="hover:text-brand">
        Commercial
      </a>
      <a href="/showroom/" class="hover:text-brand">
        Showroom
      </a>
      <a href="/projects/" class="hover:text-brand">
        Projects
      </a>
      <a href="/offers/" class="hover:text-brand">
        Offers
      </a>
      <a href="/blog/" class="hover:text-brand">
        Blog
      </a>
    </div>

    <div class="flex flex-col gap-2 text-[12.5px]">
      <span class="text-brand mb-1 text-[9.5px] font-bold tracking-[0.25em] uppercase">
        Service area
      </span>
      {townLinks.map((t) => (
        <a href={t.href} class="hover:text-brand">
          {t.name}
        </a>
      ))}
    </div>

    <div class="flex flex-col gap-2 text-[12.5px]">
      <span class="text-red-on-dark mb-1 text-[9.5px] font-bold tracking-[0.25em] uppercase">
        Restoration 24/7
      </span>
      <a href="/restoration/water-damage/" class="hover:text-brand">
        Water damage
      </a>
      <a href="/restoration/fire-and-smoke-damage/" class="hover:text-brand">
        Fire &amp; smoke
      </a>
      <a href={`tel:${business.phone.mainTel}`} class="font-extrabold">
        {business.phone.main}
      </a>
    </div>

    <address class="flex flex-col gap-2 text-[12.5px] leading-relaxed not-italic">
      <span class="text-brand mb-1 text-[9.5px] font-bold tracking-[0.25em] uppercase">Visit</span>
      <span>
        {business.showroom.streetAddress}, {business.showroom.city}, {business.showroom.state}{' '}
        {business.showroom.postalCode}
      </span>
      <span class="text-on-dark-muted">
        {business.hours.weekday} · {business.hours.weekend}
      </span>
      <a href={`mailto:${business.email}`} class="hover:text-brand">
        {business.email}
      </a>
    </address>
  </div>

  <div class="border-[#2a2a2a] text-on-dark-muted flex flex-wrap items-center justify-between gap-3 border-t pt-3.5 text-[11px]">
    <span>
      © {year} {business.legalName} ·{' '}
      {business.hicRegistrationNumber ? (
        `CT HIC reg. #${business.hicRegistrationNumber}`
      ) : (
        <span class="text-red-on-dark font-bold">CT HIC reg. # (to add)</span>
      )}
    </span>
    <div class="flex flex-wrap gap-3.5">
      {socialLinks.map((social) => (
        <a href={social.href} class="hover:text-brand" target="_blank" rel="noopener noreferrer">
          {social.label}
        </a>
      ))}
      <a href="/privacy/" class="hover:text-brand">
        Privacy
      </a>
      <span>Accessibility</span>
    </div>
  </div>

  <div class="flex flex-wrap gap-1.5">
    {business.credentials.map((c) => (
      <span class="border-[#2a2a2a] text-on-dark-muted border px-2.5 py-1.5 text-[10.5px] font-bold">
        {c.title} · {c.sub}
      </span>
    ))}
  </div>
</footer>
