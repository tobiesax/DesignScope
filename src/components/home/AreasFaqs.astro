---
import { faqs } from '../../data/home';
import { business } from '../../data/business';
import FaqAccordion from '../shared/FaqAccordion.astro';
---

<section class="bg-paper-muted grid items-start gap-10 px-4 py-12 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]">
  <div class="flex flex-col gap-4">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      Where we work
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">
      Hartford County and the Farmington Valley
    </h2>
    <div class="flex flex-wrap gap-1.5">
      {business.serviceAreas.map((town) => (
        <span class="border-border-soft bg-paper border px-3 py-2 text-xs font-semibold">
          {town}
        </span>
      ))}
    </div>
    <span class="text-muted text-xs">Each town gets its own page with local projects.</span>
  </div>

  <FaqAccordion faqs={faqs} />
</section>
