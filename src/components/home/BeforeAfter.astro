---
import { Image } from 'astro:assets';
import { mockupImages } from '../../data/mockup-images';

// TEMPORARY before/after photos — see src/data/mockup-images.ts
---

<section class="border-border grid items-center gap-8 border-t px-4 py-10 sm:px-7 [grid-template-columns:repeat(auto-fit,minmax(320px,1fr))]">
  <div class="flex flex-col gap-3.5">
    <span class="text-muted text-[10px] font-semibold tracking-[0.35em] uppercase">
      Recent project · West Hartford
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">
      Before and after, side by side
    </h2>
    <p class="text-ink-soft text-sm leading-relaxed">
      Every gallery project gets a drag slider, a short story and the town it's in, which also helps
      Google show you in that town.
    </p>
    <span class="text-muted text-xs font-semibold">Drag the slider to compare</span>
  </div>

  <div class="flex flex-col gap-3">
    <div id="ba-frame" class="bg-border relative h-80 overflow-hidden">
      <Image
        src={mockupImages['after-kitchen']}
        alt="Kitchen after renovation"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div id="ba-before-wrap" class="absolute inset-0" style="clip-path: inset(0 50% 0 0)">
        <Image
          src={mockupImages['before-kitchen']}
          alt="Kitchen before renovation"
          class="h-full w-full object-cover"
        />
      </div>
      <div
        id="ba-handle"
        class="bg-brand pointer-events-none absolute top-0 bottom-0 left-1/2 w-[3px] -ml-[1px]"
      ></div>
      <span class="bg-dark text-paper pointer-events-none absolute top-3 left-3 px-2.5 py-1.5 text-[10px] font-bold tracking-[0.2em] uppercase">
        Before
      </span>
      <span class="bg-brand text-ink pointer-events-none absolute top-3 right-3 px-2.5 py-1.5 text-[10px] font-bold tracking-[0.2em] uppercase">
        After
      </span>
    </div>
    <input
      id="ba-range"
      type="range"
      min="0"
      max="100"
      value="50"
      class="w-full accent-[#ff5f00]"
    />
  </div>
</section>

<script>
  const range = document.getElementById('ba-range') as HTMLInputElement | null;
  const wrap = document.getElementById('ba-before-wrap');
  const handle = document.getElementById('ba-handle');

  range?.addEventListener('input', () => {
    const pos = Number(range.value);
    if (wrap) wrap.style.clipPath = `inset(0 ${100 - pos}% 0 0)`;
    if (handle) handle.style.left = `${pos}%`;
  });
</script>
