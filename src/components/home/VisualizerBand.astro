---
// AI Room Visualizer promo band — plan doc sections 3 and 12 ("most
// strategic placement"): a full band directly below the homepage hero,
// and a lighter inline teaser on the Kitchen/Bathroom pages right after
// Typical Investment. One component, two variants, per plan section 13
// ("Create a reusable VisualizerBand component").
//
// The "full" variant's visual is a phone-frame mockup of the real
// /visualize/ tool's own flow (at Tobi's request, replacing an earlier
// generic before/after slider that didn't actually depict the tool) —
// a crossfade loop between its camera-capture step and its "3 options"
// results step. Same three kitchen photos /visualize/ itself shows
// (project-images.ts kitchen5/kitchen1/kitchen3), not invented thumbnails,
// and the same camera icon used on that page's own capture button, so
// this is an honest miniature of the real screens, not a mockup of
// something that doesn't exist. Pure CSS crossfade (no JS) — the
// prefers-reduced-motion override in global.css collapses it to a single
// static frame (the options screen, the more informative of the two)
// rather than an endless loop.
//
// Frame: a real iPhone frame graphic Tobi supplied (2026-11-20), replacing
// the earlier hand-built CSS bezel/Dynamic-Island/home-indicator version.
// Cropped to just the phone (mockup-images.ts 'iphone-frame') — its
// "screen" is genuinely transparent in the source file, not painted
// white, so the crossfading content sits in a div underneath it, inset to
// match the frame's measured bezel thickness, with the frame image drawn
// on top (its own Dynamic Island therefore sits over the content exactly
// like a real phone's does).
import { Image } from 'astro:assets';
import { projectImages } from '../../data/project-images';
import { mockupImages } from '../../data/mockup-images';

interface Props {
  variant?: 'full' | 'teaser';
}

const { variant = 'full' } = Astro.props;
---

{variant === 'full' ? (
  <section class="border-border bg-paper-muted border-t px-4 py-12 sm:px-7">
    <div class="grid items-center gap-8 [grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr))]">
      <div class="flex flex-col gap-3.5">
        <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
          New · Free tool
        </span>
        <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">
          See your kitchen remodeled in 60 seconds
        </h2>
        <p class="text-ink-soft text-sm leading-relaxed">
          Snap a photo, pick a style, and see three real Design Scope looks for your own kitchen or
          bathroom. Then come see it, touch it, decide — at the showroom.
        </p>
        <div>
          <a
            href="/visualize/"
            class="bg-brand text-ink inline-flex items-center gap-1.5 px-5 py-3.5 text-[13px] font-extrabold"
          >
            Try it on your kitchen →
          </a>
        </div>
        <span class="text-muted text-[11px]">AI concept for inspiration only.</span>
      </div>

      <div class="flex justify-center">
        <div class="relative h-[419px] w-[204px] sm:h-[460px] sm:w-[224px]" aria-hidden="true">
          <!-- Content layer, inset to match the real frame's measured
               bezel thickness (left 4.33%, right 4.55%, top 1.9%,
               bottom 2%) so it sits exactly inside the frame's own
               transparent screen cutout. -->
          <div
            class="absolute overflow-hidden rounded-[1.8rem] bg-white"
            style="left:4.33%;right:4.55%;top:1.9%;bottom:2%;"
          >
            <!-- Screen 1: the real tool's capture step -->
            <div class="viz-phone-screen bg-paper-muted absolute inset-0 flex flex-col items-center justify-center gap-3 px-4 text-center">
              <span class="text-muted text-[9.5px] font-extrabold tracking-[0.2em] uppercase">
                Snap your kitchen
              </span>
              <span class="bg-brand text-ink flex h-14 w-14 items-center justify-center rounded-full">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 7h3l2-2.5h6L17 7h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z" />
                  <circle cx="12" cy="13" r="3.5" />
                </svg>
              </span>
              <span class="text-[11px] font-bold">Take a photo</span>
            </div>

            <!-- Screen 2: the real tool's "3 options" results step -->
            <div class="viz-phone-screen-2 absolute inset-0 flex flex-col gap-1.5 bg-white p-3 pt-8">
              <span class="text-muted px-0.5 text-[9px] font-extrabold tracking-[0.15em] uppercase">
                Your 3 options
              </span>
              <div class="flex flex-1 flex-col gap-1.5">
                <Image
                  src={projectImages.kitchen5}
                  alt="Design Scope kitchen example 1"
                  class="h-full w-full flex-1 rounded-sm object-cover"
                />
                <Image
                  src={projectImages.kitchen1}
                  alt="Design Scope kitchen example 2"
                  class="h-full w-full flex-1 rounded-sm object-cover"
                />
                <Image
                  src={projectImages.kitchen3}
                  alt="Design Scope kitchen example 3"
                  class="h-full w-full flex-1 rounded-sm object-cover"
                />
              </div>
            </div>
          </div>

          <!-- Frame on top — its Dynamic Island sits over the content
               automatically since this image is drawn above it. -->
          <Image
            src={mockupImages['iphone-frame']}
            alt=""
            class="pointer-events-none absolute inset-0 z-10 h-full w-full"
          />
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="border-line bg-paper-muted flex flex-col items-start gap-3 border px-5 py-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-1">
      <span class="text-brand-dark text-[10px] font-extrabold tracking-[0.25em] uppercase">
        New · Free tool
      </span>
      <span class="text-[15px] font-extrabold">
        Want to see this in your own kitchen? Try the visualizer.
      </span>
    </div>
    <a href="/visualize/" class="bg-ink text-paper flex-shrink-0 px-4.5 py-3 text-[13px] font-extrabold">
      Try it free →
    </a>
  </section>
)}

{variant === 'full' && (
  <style>
    /* Loops: capture screen visible 0–45%, crossfades out 45–55%, options
       screen takes over 55–100% (then wraps). prefers-reduced-motion's
       blanket override (global.css) forces iteration-count:1, so a
       reduced-motion visitor's animation plays once and stops on each
       keyframe's final value — screen 1 ends hidden, screen 2 ends shown,
       landing on a single static "3 options" frame rather than looping. */
    .viz-phone-screen {
      animation: viz-phone-fade-1 7s ease-in-out infinite;
    }
    .viz-phone-screen-2 {
      animation: viz-phone-fade-2 7s ease-in-out infinite;
    }
    @keyframes viz-phone-fade-1 {
      0%,
      45% {
        opacity: 1;
      }
      55%,
      100% {
        opacity: 0;
      }
    }
    @keyframes viz-phone-fade-2 {
      0%,
      45% {
        opacity: 0;
      }
      55%,
      100% {
        opacity: 1;
      }
    }
  </style>
)}
