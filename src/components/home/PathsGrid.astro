---
import { Image } from 'astro:assets';
import { paths } from '../../data/home';
import { mockupImages } from '../../data/mockup-images';

// TEMPORARY path photos — see src/data/mockup-images.ts
const images: Record<string, keyof typeof mockupImages> = {
  Remodeling: 'path-remodeling',
  Restoration: 'path-restoration',
  Commercial: 'path-commercial',
  'Showroom & Products': 'showroom',
};

const barClass = { brand: 'border-brand', urgent: 'border-urgent' } as const;
const ctaClass = { brand: 'text-brand-dark', urgent: 'text-urgent' } as const;
---

<section class="bg-paper-muted flex flex-col gap-5 px-4 py-10 sm:px-7">
  <span class="text-[10px] font-semibold tracking-[0.35em] uppercase">How can we help?</span>
  <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(200px,1fr))]">
    {paths.map((path) => (
      <a href={path.href} class="card-hover bg-paper flex flex-col overflow-hidden">
        <Image
          src={mockupImages[images[path.title]]}
          alt=""
          class="h-[150px] w-full object-cover"
        />
        <div class={`flex flex-col gap-1.5 border-t-[3px] p-4 ${barClass[path.bar]}`}>
          <span class="text-[15px] font-extrabold">{path.title}</span>
          <span class="text-muted text-xs leading-relaxed">{path.sub}</span>
          <span class={`text-xs font-extrabold ${ctaClass[path.bar]}`}>{path.cta} →</span>
        </div>
      </a>
    ))}
  </div>
</section>
