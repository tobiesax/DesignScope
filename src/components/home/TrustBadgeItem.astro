---
import type { business } from '../../data/business';

interface Props {
  credential: (typeof business.credentials)[number];
  hidden?: boolean;
}

const { credential: c, hidden = false } = Astro.props;
---

<div
  class="group flex min-w-0 flex-shrink-0 items-center gap-4 px-6"
  aria-hidden={hidden ? 'true' : undefined}
>
  <span class="relative flex h-15 w-15 flex-shrink-0 items-center justify-center">
    <svg
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="text-ink"
    >
      {c.icon.split(' M').map((segment, j) => (
        <path d={j === 0 ? segment : `M${segment}`} />
      ))}
    </svg>
    {c.mark && (
      <span class="bg-ink text-paper absolute -right-1 -bottom-1 flex h-6 min-w-6 items-center justify-center rounded-full px-1 text-[10px] leading-none font-black">
        {c.mark}
      </span>
    )}
  </span>
  <div class="flex min-w-0 flex-col gap-0.5 whitespace-nowrap">
    <span class="text-[16px] leading-tight font-extrabold tracking-tight">{c.title}</span>
    <span class="text-muted truncate text-[12px]">{c.sub}</span>
  </div>
</div>
