---
// "How it works" — 4 numbered steps, a time chip per step, and a centered
// CTA. Originally matched the handoff's home page section exactly, with a
// connecting line running from each numbered badge to the next; dropped at
// Tobi's request when centering every step, then brought back redesigned
// (2026-11-18) so centering and the connector coexist: a single line laid
// behind the badges rather than one per-card segment, positioned to pass
// through each badge's exact center instead of starting from its edge,
// horizontal on desktop (sm:grid-cols-4, each column an equal 25% so a
// straight line from the 12.5% mark to the 87.5% mark hits all 4 centers).
//
// Mobile (2026-11-28, at Tobi's request: the old one-column stack of 4
// centered, text-heavy cards with a connector line between each ran very
// tall on a phone). Now a single column of compact, left-aligned
// number-plus-text rows instead of centered blocks — same information,
// a fraction of the height (a 2x2 grid was tried first, then Tobi asked
// for one step per line instead, not two side by side). The connector
// line stays desktop-only.
const steps = [
  {
    n: '01',
    when: 'Day one',
    t: 'Visit or call',
    b: 'Walk in, book online or text us photos.',
  },
  {
    n: '02',
    when: 'Week 1–2',
    t: 'Design',
    b: '3D design in our showroom, real samples.',
  },
  {
    n: '03',
    when: 'Within 24h',
    t: 'Quote in 24h',
    b: 'Written, itemised, price-matched.',
  },
  {
    n: '04',
    when: 'Weeks 3+',
    t: 'We build it',
    b: 'Our own crews and a 6-month warranty.',
  },
];
---

<section class="flex flex-col gap-8 border-b border-[#e8e8e8] px-4 py-14 sm:px-7">
  <div class="mx-auto flex max-w-[560px] flex-col items-center gap-2.5 text-center">
    <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
      How it works
    </span>
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">
      From first visit to finished room, one team the whole way
    </h2>
  </div>

  <div class="relative flex flex-col gap-5 sm:grid sm:grid-cols-4 sm:gap-7">
    <!-- Connector: a single line behind the badges, not one per card —
         that's what lets it pass through each badge's centre instead of
         starting from an edge. Desktop only. -->
    <div
      class="bg-ink pointer-events-none absolute top-6 right-[12.5%] left-[12.5%] hidden h-0.5 sm:block"
      aria-hidden="true"
    ></div>

    {steps.map((step, i) => (
      <div
        class="relative flex min-w-0 items-start gap-2.5 text-left sm:flex-col sm:items-center sm:gap-3.5 sm:text-center"
      >
        <div class="flex shrink-0 items-center justify-center">
          <span
            class:list={[
              'flex h-9 w-9 flex-shrink-0 items-center justify-center border-2 border-ink text-[12.5px] font-black sm:h-12 sm:w-12 sm:text-[15px]',
              i === 3 ? 'bg-brand-dark text-paper' : 'bg-white text-ink',
            ]}
          >
            {step.n}
          </span>
        </div>
        <div class="flex flex-1 flex-col items-start gap-1 sm:items-center sm:gap-1.5">
          <div class="flex flex-col items-start gap-1 sm:items-center sm:gap-1.5">
            <span class="bg-[#f0f0f0] px-1.5 py-0.5 text-[9.5px] font-extrabold tracking-[0.12em] uppercase sm:text-[10px]">
              {step.when}
            </span>
            <span class="text-[14.5px] font-black tracking-tight sm:text-[18px]">{step.t}</span>
          </div>
          <span class="text-muted block max-w-[240px] text-[12px] leading-snug sm:mx-auto sm:text-[13.5px] sm:leading-relaxed">
            {step.b}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="flex justify-center">
    <a
      href="/book/"
      data-open-booking
      class="bg-brand text-ink px-6 py-3.5 text-[13.5px] font-extrabold"
    >
      Start with step one →
    </a>
  </div>
</section>
