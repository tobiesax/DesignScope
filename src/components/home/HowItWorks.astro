---
// "How it works" — matches the handoff's home page section exactly: 4
// numbered steps joined by a connecting line, a time chip per step, and a
// centered CTA.
const steps = [
  {
    n: '01',
    when: 'Day one',
    t: 'Visit or call',
    b: 'Walk in, book online or text us photos.',
  },
  {
    n: '02',
    when: 'Week 1–2',
    t: 'Design',
    b: '3D design in our showroom, real samples.',
  },
  {
    n: '03',
    when: 'Within 24h',
    t: 'Quote in 24h',
    b: 'Written, itemised, price-matched.',
  },
  {
    n: '04',
    when: 'Weeks 3+',
    t: 'We build it',
    b: 'Our own crews and a 6-month warranty.',
  },
];
---

<section class="flex flex-col gap-8 border-b border-[#e8e8e8] px-4 py-14 sm:px-7">
  <div class="flex flex-col gap-2.5 max-w-[560px]">
    <span class="flex items-center gap-2.5 text-[10px] font-extrabold tracking-[0.3em] uppercase before:block before:h-0.5 before:w-5 before:flex-shrink-0 before:bg-brand before:content-['']">
      How it works
    </span>
    <h2 class="text-[26px] font-black tracking-tight sm:text-[34px]">
      From first visit to finished room, one team the whole way
    </h2>
  </div>

  <div class="flex flex-col gap-5 sm:grid sm:grid-cols-4 sm:gap-7">
    {steps.map((step, i) => (
      <div
        class:list={[
          'flex min-w-0 items-start gap-4 border-b border-[#e8e8e8] pb-5 sm:flex-col sm:gap-3.5 sm:border-b-0 sm:pb-0 last:border-b-0 last:pb-0',
        ]}
      >
        <div class="flex shrink-0 items-center sm:w-full">
          <span
            class:list={[
              'flex h-11 w-11 flex-shrink-0 items-center justify-center border-2 border-ink text-[14px] font-black sm:h-12 sm:w-12 sm:text-[15px]',
              i === 3 ? 'bg-brand text-ink' : 'bg-white text-ink',
            ]}
          >
            {step.n}
          </span>
          <span
            class:list={['hidden h-0.5 flex-1 sm:block', i === 3 ? 'bg-transparent' : 'bg-ink']}
          ></span>
        </div>
        <div class="flex flex-1 flex-col gap-1.5 pt-0.5 sm:pt-0 sm:pr-5">
          <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-start sm:gap-1.5">
            <span class="bg-[#f0f0f0] self-start px-1.5 py-0.5 text-[10px] font-extrabold tracking-[0.12em] uppercase">
              {step.when}
            </span>
            <span class="text-[17px] font-black tracking-tight sm:text-[18px]">{step.t}</span>
          </div>
          <span class="text-muted max-w-[240px] text-[13px] leading-relaxed sm:text-[13.5px]">
            {step.b}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="flex justify-center">
    <a
      href="/book/"
      data-open-booking
      class="border-brand bg-brand text-ink border-2 px-6 py-3.5 text-[13.5px] font-extrabold"
    >
      Start with step one →
    </a>
  </div>
</section>
