---
// Trust badge strip, directly under the hero — matches the design
// handoff's "Global components → Trust badges" exactly on desktop
// (a wrapped row). On mobile it's a swipeable scroll-snap carousel
// instead of a static 2-column grid, at Tobi's request — same
// lightweight CSS-scroll-snap + IntersectionObserver pattern as
// ReviewCarousel.astro, just without auto-advance or arrow buttons
// (a decorative badge strip doesn't need either). The BBB and Houzz
// badges are unconfirmed placeholders (CONTENT_GAPS.md); swap for the
// official member artwork once Stephen confirms them.
import { business } from '../../data/business';
---

<section class="border-border-soft border-b bg-white px-4 py-4.5 sm:px-7">
  <div
    id="badges-track"
    class="flex gap-2 overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] sm:flex-wrap sm:justify-center sm:overflow-visible [&::-webkit-scrollbar]:hidden"
    style="scroll-snap-type: x mandatory;"
  >
    {business.credentials.map((c, i) => (
      <div
        data-badge-card
        data-index={i}
        class="border-border hover:border-ink box-border flex min-w-0 flex-shrink-0 basis-[47%] items-center gap-2.5 border py-2 pr-2 pl-2 sm:w-auto sm:flex-shrink sm:basis-auto sm:gap-3 sm:pr-4"
        style="scroll-snap-align: start;"
      >
        <span class="bg-ink relative flex h-11 w-11 flex-shrink-0 items-center justify-center">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#ffffff"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {c.icon.split(' M').map((segment, j) => (
              <path d={j === 0 ? segment : `M${segment}`} />
            ))}
          </svg>
          {c.mark && (
            <span class="bg-brand-dark text-paper absolute -right-1.5 -bottom-1.5 px-1 py-0.5 text-[9px] leading-[1.1] font-black">
              {c.mark}
            </span>
          )}
        </span>
        <div class="flex min-w-0 flex-col gap-0.5">
          <span class="text-[12.5px] leading-tight font-extrabold">{c.title}</span>
          <span class="text-muted truncate text-[10.5px]">{c.sub}</span>
        </div>
      </div>
    ))}
  </div>

  <div id="badges-dots" class="mt-2.5 flex justify-center gap-1.5 sm:hidden">
    {business.credentials.map((_, i) => (
      <button
        type="button"
        data-dot={i}
        aria-label={`Show trust badge ${i + 1}`}
        class:list={[
          'h-1 cursor-pointer transition-[width,background-color]',
          i === 0 ? 'bg-brand w-5' : 'w-2 bg-[#dddddd]',
        ]}
      ></button>
    ))}
  </div>
</section>

<script>
  const track = document.getElementById('badges-track');
  const dotsWrap = document.getElementById('badges-dots');
  if (track && dotsWrap) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('[data-badge-card]'));
    const dots = Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>('[data-dot]'));

    const setActive = (index: number) => {
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('bg-brand', active);
        dot.classList.toggle('w-5', active);
        dot.classList.toggle('bg-[#dddddd]', !active);
        dot.classList.toggle('w-2', !active);
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            const index = cards.indexOf(entry.target as HTMLElement);
            if (index !== -1) setActive(index);
          }
        });
      },
      { root: track, threshold: 0.6 },
    );
    cards.forEach((card) => io.observe(card));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const card = cards[i];
        if (card) track.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
      });
    });
  }
</script>
