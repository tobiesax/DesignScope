---
// Trust badge strip, directly under the hero — a continuous
// right-to-left marquee on every breakpoint now (was desktop-static,
// mobile-marquee; widened to desktop too at Tobi's request). The
// credential list is rendered twice back to back so a -50%
// translateX loop has no visible seam, paused under
// prefers-reduced-motion (global.css) and on hover. The BBB and
// Houzz badges are unconfirmed placeholders (CONTENT_GAPS.md); swap
// for the official member artwork once Stephen confirms them.
//
// Restyled 2026-11-20 at Tobi's request: dropped each badge's bordered
// rectangle, then dropped the tinted circle behind the icon too (plain
// black icon now) — a cleaner, more editorial look overall: a bigger
// icon, bigger text, generous spacing between items instead of boxes.
// See TrustBadgeItem.astro.
import { business } from '../../data/business';
import TrustBadgeItem from './TrustBadgeItem.astro';
---

<section class="border-border-soft border-b bg-white py-7">
  <div id="trust-marquee-mask" class="marquee-mask overflow-hidden">
    <div class="marquee-track flex w-max items-center">
      {business.credentials.map((c) => (
        <TrustBadgeItem credential={c} />
      ))}
      {business.credentials.map((c) => (
        <TrustBadgeItem credential={c} hidden />
      ))}
    </div>
  </div>
</section>

<script>
  // This marquee animates forever by default (40s infinite loop,
  // global.css) — harmless on its own, but it's one more continuously
  // composited layer fighting for GPU time while a visitor scrolls past
  // other animated sections (hero Ken Burns, scroll-reveal), which on a
  // loaded-down phone can show up as scroll-time rendering glitches.
  // Pausing it the moment it's off-screen keeps it from costing anything
  // once the visitor has scrolled past it.
  const mask = document.getElementById('trust-marquee-mask');
  if (mask && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => mask.classList.toggle('is-offscreen', !entry.isIntersecting),
      { threshold: 0 },
    );
    io.observe(mask);
  }
</script>
