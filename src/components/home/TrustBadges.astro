---
// Trust badge strip, directly under the hero — matches the design
// handoff's "Global components → Trust badges" exactly. The BBB and Houzz
// badges are unconfirmed placeholders (CONTENT_GAPS.md); swap for the
// official member artwork once Stephen confirms them.
import { business } from '../../data/business';
---

<section class="border-border-soft flex flex-wrap justify-center gap-2 border-b bg-white px-4 py-4.5 sm:px-7">
  {business.credentials.map((c) => (
    <div class="border-border hover:border-ink flex items-center gap-3 border py-2 pr-4 pl-2">
      <span class="bg-ink relative flex h-11 w-11 flex-shrink-0 items-center justify-center">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#ff5f00"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {c.icon.split(' M').map((segment, i) => (
            <path d={i === 0 ? segment : `M${segment}`} />
          ))}
        </svg>
        {c.mark && (
          <span class="bg-brand text-ink absolute -right-1.5 -bottom-1.5 px-1 py-0.5 text-[9px] leading-[1.1] font-black">
            {c.mark}
          </span>
        )}
      </span>
      <div class="flex flex-col gap-0.5">
        <span class="text-[12.5px] font-extrabold">{c.title}</span>
        <span class="text-muted text-[10.5px]">{c.sub}</span>
      </div>
    </div>
  ))}
</section>
