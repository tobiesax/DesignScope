---
// Home hero — matches the handoff's slideshow background (crossfade +
// Ken Burns, pause/play control) and gradient/content layout. TEMPORARY
// photos — see src/data/mockup-images.ts.
import { Image } from 'astro:assets';
import { mockupImages } from '../../data/mockup-images';

// 3 slides, not the handoff's original 5 — dropped 'ba-after' (read as
// a near-duplicate of 'hero-kitchen''s cinematic-gradient photo right
// next to it) and 'proj-bath-avon' (at Tobi's request). Both keys are
// untouched and still used correctly elsewhere: 'ba-after' in
// BeforeAfter.astro's slider, the kitchen-bloomfield case study, the
// Bloomfield town page and the style quiz (paired with 'ba-before' as
// a real before/after); 'proj-bath-avon' on the Avon town page and its
// case study.
//
// 'ba-before' lost its 'Before' tag for the same reason: with 'ba-after'
// gone from this carousel, there's no honest 'After' to pair it with —
// tagging 'hero-kitchen' (a different AI-generated kitchen) as the
// after would falsely claim it's the same remodeled room (CLAUDE.md
// rule 2). An orphaned "Before" badge alone also just read as a bug.
const slides = [
  { key: 'ba-before', tag: '', dark: true },
  { key: 'hero-kitchen', tag: '', dark: false },
  { key: 'living-room-sunset', tag: '', dark: false },
] as const;
---

<section
  id="hero-slideshow"
  class="relative flex min-h-[520px] items-end overflow-hidden bg-dark sm:min-h-[calc(100vh-110px)]"
>
  {slides.map((slide, i) => (
    <div
      class:list={[
        'hero-slide absolute inset-0',
        i % 2 === 0 ? 'ken-0' : 'ken-1',
        i === 0 && 'is-active',
      ]}
      data-index={i}
    >
      <Image src={mockupImages[slide.key]} alt="" widths={[640, 1024, 1600]} sizes="100vw" />
      {slide.tag && (
        <span
          class:list={[
            'absolute top-6 left-6 px-2.5 py-1.5 text-[10px] font-extrabold tracking-[0.2em] uppercase',
            slide.dark ? 'bg-ink text-paper' : 'bg-brand text-ink',
          ]}
        >
          {slide.tag}
        </span>
      )}
    </div>
  ))}

  <!-- Two stacked gradients: the original bottom fade, plus a left-side
       fade over it — the text content below sits bottom-left, so the
       left side needs its own darkening independent of how bright that
       slide's photo is on the right. -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:linear-gradient(90deg,rgba(14,14,14,0.85) 0%,rgba(14,14,14,0.55) 35%,rgba(14,14,14,0.15) 65%,rgba(14,14,14,0) 85%),linear-gradient(0deg,rgba(14,14,14,0.94),rgba(14,14,14,0.62) 45%,rgba(14,14,14,0.25) 75%,rgba(14,14,14,0.05) 100%)"
  ></div>

  <button
    type="button"
    id="hero-pause-toggle"
    aria-label="Pause background"
    class="absolute right-4 bottom-8 z-10 flex h-11 w-11 items-center justify-center text-sm font-black text-paper sm:right-7"
    style="text-shadow: 0 1px 4px rgba(0,0,0,0.6);"
  >
    II
  </button>

  <div class="relative z-[2] flex max-w-[520px] flex-col gap-3 px-4 py-8 text-paper sm:px-7">
    <span class="bg-brand-dark text-paper self-start px-2.5 py-1.5 text-[10px] font-extrabold tracking-[0.25em] uppercase">
      Planning a project
    </span>
    <h1 class="text-[34px] leading-[1.02] font-black tracking-tight sm:text-[52px]">
      Kitchens, baths, whole homes — and the emergencies in between
    </h1>
    <span class="text-[15px] leading-relaxed font-medium text-[#ededed]">
      Family-owned in Connecticut since 2016. Remodeling, restoration and commercial work, all from
      one team, with a written quote in 24 hours.
    </span>
    <!-- Hidden on mobile: Layout.astro's sticky bottom bar already covers
         Book free consultation + Call there (CLAUDE.md "Mobile first" —
         the phone number and Book button stay reachable on every page,
         just via that bar instead of a second, duplicate set of CTAs). -->
    <div class="hidden flex-wrap gap-2 md:flex">
      <a
        href="/book/"
        data-open-booking
        class="bg-brand text-ink px-5 py-3.5 text-[13px] font-extrabold"
      >
        Book free consultation
      </a>
      <a
        href="/remodeling/"
        class="border-[1.5px] border-paper px-5 py-3.5 text-[13px] font-extrabold text-paper"
      >
        Explore Remodeling →
      </a>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('hero-slideshow');
  const toggle = document.getElementById('hero-pause-toggle');
  if (root && toggle) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.hero-slide'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = reduceMotion;
    let i = 0;

    const render = () => {
      slides.forEach((s, idx) => s.classList.toggle('is-active', idx === i));
      root.classList.toggle('is-paused', paused);
      toggle.textContent = paused ? '▶' : 'II';
      toggle.setAttribute('aria-label', paused ? 'Play background' : 'Pause background');
    };
    render();

    let timer: ReturnType<typeof setInterval> | null = null;
    const start = () => {
      if (timer) return;
      timer = setInterval(() => {
        i = (i + 1) % slides.length;
        render();
      }, 5200);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    if (!paused) start();

    toggle.addEventListener('click', () => {
      paused = !paused;
      if (paused) stop();
      else start();
      render();
    });
  }
</script>
