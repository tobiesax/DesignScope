---
import { business } from '../../data/business';
---

<section class="flex flex-col gap-5.5 px-4 py-12 sm:px-7">
  <div class="flex flex-col gap-2.5">
    <span class="text-brand-dark text-[10px] font-semibold tracking-[0.35em] uppercase">
      Current offers
    </span>
    <h2 class="text-2xl font-black tracking-tight sm:text-[28px]">Savings, stated clearly</h2>
  </div>
  <div class="grid gap-3.5 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]">
    <div class="border-brand flex items-center gap-5 border-2 border-dashed p-6.5">
      <span class="text-brand-dark text-5xl font-black tracking-tight">10%</span>
      <div class="flex flex-col gap-1">
        <span class="text-[15px] font-extrabold">Off your first project</span>
        <span class="text-muted text-xs leading-relaxed">
          New customers, any design and construction project. Mention when booking.
        </span>
      </div>
    </div>
    <div class="border-dark flex items-center gap-5 border-2 border-dashed p-6.5">
      <span class="text-5xl font-black tracking-tight">5%</span>
      <div class="flex flex-col gap-1">
        <span class="text-[15px] font-extrabold">Military &amp; veteran discount</span>
        <span class="text-muted text-xs leading-relaxed">
          Active service members and veterans, all services.
        </span>
      </div>
    </div>
  </div>
  <span class="text-muted text-xs">
    Offers can't be combined. Text START to {business.phone.textOffers} for future offers.
  </span>
</section>
