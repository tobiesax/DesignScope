---
import { business } from '../../data/business';
---

<section class="flex flex-col gap-3.5 px-4 pt-2 pb-5 sm:px-7">
  <div class="grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(250px,1fr))]">
    <div class="border-brand flex items-center gap-5 border-2 border-dashed p-6.5">
      <span class="text-brand-dark text-5xl font-black tracking-tight">10%</span>
      <div class="flex flex-col gap-1">
        <span class="text-[15px] font-extrabold">Off kitchen cabinet costs</span>
        <span class="text-muted text-xs leading-relaxed">
          New customers receive 10% off kitchen cabinet costs. Must mention this coupon at the
          time of scheduling.
        </span>
      </div>
    </div>
    <div class="border-dark flex items-center gap-5 border-2 border-dashed p-6.5">
      <span class="text-5xl font-black tracking-tight">5%</span>
      <div class="flex flex-col gap-1">
        <span class="text-[15px] font-extrabold">Military &amp; veteran discount</span>
        <span class="text-muted text-xs leading-relaxed">
          Design Scope proudly offers 5% off all design and construction services to active
          military members and veterans. We're honored to serve those who've served our country.
        </span>
      </div>
    </div>
  </div>
  <span class="text-muted text-xs">
    Not valid with any other offers or promotions. Restrictions apply. Text START to
    {business.phone.main} for future offers.
  </span>
  <span class="text-muted text-xs">
    Msg frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out, HELP for help. See{' '}
    <a href="/terms/" class="underline">
      Terms
    </a>{' '}
    and{' '}
    <a href="/privacy/" class="underline">
      Privacy
    </a>
    .
  </span>
</section>
